{
  "schema": 2,
  "description": "Shell is allow by default. Only shellDestructiveDeny is restricted at agent level; gateway action lists are optional and only apply when using team-shell.mjs.",
  "shellDestructiveDeny": [
    "git reset --hard*",
    "git clean*",
    "git checkout --*",
    "git checkout -f*",
    "git restore*",
    "git switch -f*",
    "git switch --discard-changes*",
    "git reset --merge*",
    "git branch -D*",
    "git branch -d*",
    "git tag -d*",
    "git tag --delete*",
    "git stash clear*",
    "git stash drop*",
    "git update-ref -d*",
    "git reflog expire*",
    "git gc --prune*",
    "git filter-branch*",
    "git filter-repo*",
    "git push --force*",
    "git push * --force*",
    "git push -f*",
    "git push * -f*",
    "git push --mirror*",
    "git push * +*",
    "git push --delete*",
    "git push * --delete*",
    "git worktree remove -*f*",
    "git worktree remove * -*f*",
    "rm -rf*",
    "rm -r*",
    "del /s*",
    "del /q /s*",
    "rd /s*",
    "rd /q /s*",
    "Remove-Item * -Recurse*",
    "Remove-Item -Recurse*",
    "docker system prune*",
    "docker volume prune*",
    "docker image prune*",
    "terraform destroy*",
    "kubectl delete*"
  ],
  "shellMustAllow": [
    "git add",
    "git add -A",
    "git commit",
    "git commit *",
    "git worktree remove",
    "git push",
    "git push *",
    "git tag",
    "npm publish*",
    "kubectl apply*",
    "terraform apply*",
    "Get-Content .env"
  ],
  "roles": {
    "chief": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.rev-parse",
        "script.state-check",
        "script.retro-check",
        "script.checkpoint-check",
        "script.artifact-check",
        "script.growth-check",
        "script.audit-state",
        "script.permission-lint"
      ]
    },
    "product-manager": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    },
    "ux-designer": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    },
    "system-architect": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    },
    "engineer": {
      "gateway": [
        "git.status",
        "git.diff",
        "build.compile",
        "build.test",
        "build.clean-test",
        "build.package"
      ]
    },
    "code-reviewer": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.rev-parse",
        "build.compile",
        "build.test",
        "build.verify",
        "build.package",
        "scan.dependency"
      ]
    },
    "qa-engineer": {
      "gateway": [
        "git.status",
        "build.compile",
        "build.test",
        "build.clean-test",
        "build.package"
      ]
    },
    "security-auditor": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "build.test",
        "build.verify",
        "scan.dependency",
        "scan.secrets",
        "scan.sast"
      ]
    },
    "devops-engineer": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "build.compile",
        "build.test",
        "build.package",
        "build.verify",
        "script.growth-check",
        "script.artifact-check",
        "script.checkpoint-check"
      ]
    },
    "technical-writer": {
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    }
  }
}
