      },
      "forbidden": {
        "shell": [
          "git add *",
          "git commit *",
          "git push *",
          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.rev-parse",
        "build.compile",
        "build.test",
        "build.verify",
        "build.package",
        "scan.dependency"
      ]
    },
    "qa-engineer": {
