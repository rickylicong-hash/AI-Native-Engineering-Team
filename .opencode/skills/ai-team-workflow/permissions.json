{
  "schema": 1,
  "description": "AI Team role permission matrix. permission-lint validates these required/forbidden actions against each agent's frontmatter.",
  "roles": {
    "chief": {
      "required": {
        "shell": [
          "git status *",
          "git diff *",
          "git log *",
          "git show *",
          "git rev-parse *",
          "node *state-check.mjs*",
          "node *retro-check.mjs*",
          "node *checkpoint-check.mjs*",
          "node *artifact-check.mjs*",
          "node *growth-check.mjs*",
          "node *brief-lint.mjs*",
          "node *review-check.mjs*",
          "node *audit-state.mjs*",
          "node *permission-lint.mjs*",
          "node *permission-doctor.mjs*",
          "Get-Content */.ai-team/state/*",
          "node *team-shell.mjs --role chief *"
        ],
        "edit": [
          ".ai-team/state/*",
          ".ai-team/tasks/*",
          ".ai-team/team/*",
          ".ai-team/README.md"
        ]
      },
      "forbidden": {
        "shell": [
          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*",
          "git add -A *",
          "git add .",
          "git add . *",
          "mvn *test*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.rev-parse",
        "script.state-check",
        "script.retro-check",
        "script.checkpoint-check",
        "script.artifact-check",
        "script.growth-check",
        "script.audit-state",
        "script.permission-lint"
      ]
    },
    "product-manager": {
      "required": {
        "shell": [
          "git status *",
          "git diff *",
          "git log *",
          "pwd",
          "ls *",
          "dir *",
          "node *team-shell.mjs --role product-manager *"
        ],
        "edit": [
          ".ai-team/product/*"
        ]
      },
      "forbidden": {
        "shell": [
          "git add *",
          "git commit *",
          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    },
    "ux-designer": {
      "required": {
