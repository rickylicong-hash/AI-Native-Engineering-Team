      },
      "forbidden": {
        "shell": [
          "git add -A",
          "git add -A *",
          "git add --all *",
          "git add .",
          "git add . *",
          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "build.compile",
        "build.test",
        "build.package",
        "build.verify",
        "script.growth-check",
        "script.artifact-check",
        "script.checkpoint-check"
      ]
    },
    "technical-writer": {
      "required": {
        "shell": [
          "git status *",
          "git diff *",
          "git log *",
          "node *team-shell.mjs --role technical-writer *"
        ],
        "edit": [
          "docs/*",
          "README.md",
          "CHANGELOG.md",
          "CONTRIBUTING.md",
          "SECURITY.md"
        ]
      },
      "forbidden": {
        "shell": [
          "git add -A",
