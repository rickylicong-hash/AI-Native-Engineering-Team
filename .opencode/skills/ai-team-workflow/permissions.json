          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    },
    "engineer": {
      "required": {
        "shell": [
          "git status *",
          "git diff *",
          "mvn *test*",
          "node *team-shell.mjs --role engineer *"
        ],
        "edit": [
          ".ai-team/work/*"
        ]
      },
      "forbidden": {
        "shell": [
          "git add -A",
          "git add -A *",
          "git add --all *",
          "git add .",
          "git add . *",
          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "build.compile",
        "build.test",
        "build.clean-test",
        "build.package"
      ]
    },
    "code-reviewer": {
      "required": {
