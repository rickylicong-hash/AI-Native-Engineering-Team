          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "build.test",
        "build.verify",
        "scan.dependency",
