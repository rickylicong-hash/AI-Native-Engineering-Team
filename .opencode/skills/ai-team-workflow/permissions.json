          "node *team-shell.mjs --role ux-designer *"
        ],
        "edit": [
          ".ai-team/design/ux/*",
          "design/*",
          "mockups/*",
          "prototypes/*"
        ]
      },
      "forbidden": {
        "shell": [
          "git add *",
          "git commit *",
          "*;*",
          "*&&*",
          "*||*",
          "*2>&1*"
        ]
      },
      "gateway": [
        "git.status",
        "git.diff",
        "git.log"
      ]
    },
    "system-architect": {
      "required": {
        "shell": [
          "git status *",
          "git diff *",
          "git log *",
          "java -version *",
          "mvn -v *",
          "node *team-shell.mjs --role system-architect *"
        ],
        "edit": [
          ".ai-team/design/architecture/*",
          ".ai-team/design/adr/*",
          "docs/adr/*"
        ]
      },
      "forbidden": {
        "shell": [
          "git add *",
